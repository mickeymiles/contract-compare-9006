function renderFundCashflow(){
  const d=fundDetailData;
  if(!d) return;
  const cf=d.cashflow||[];
  const cm=d.cashflow_monthly||[];
  if(!cf.length && !cm.length){
    document.getElementById('fundDetailContent').innerHTML='<div class="ana-empty"><div>该合同无现金流记录</div></div>';
    return;
  }
  let h='';
  h+='<div class="chart-box"><h3>📈 累计现金流曲线（净现金余额，负=垫资中）</h3><div id="cashflowChart" style="height:300px"></div></div>';
  // 当前现金流高亮卡片（最新月份余额）
  if(cm.length){
    const latest=cm[cm.length-1];
    const curBalance=latest.balance;
    const col='var(--cyan)';
    h+='<div style="margin-bottom:16px;padding:16px;background:var(--card);border:1px solid var(--cyan);border-radius:8px">';
    h+='<div style="font-size:12px;color:var(--text2)">💵 当前现金流（截至 '+latest.month+'，负值=垫资中）</div>';
    h+='<div style="font-size:28px;font-weight:bold;color:'+col+';margin-top:4px">¥'+curBalance.toLocaleString()+'</div>';
    h+='</div>';
  }
  // 按月表格（时间倒序，最上一行=当前现金流）
  if(cm.length){
    const reversed=[...cm].reverse();
    h+='<div class="panel"><h3>📅 按月现金流汇总（时间倒序）</h3><div class="twrap"><table class="ana-table"><thead><tr>';
    h+='<th>月份</th><th>付款</th><th>回款</th><th>净现金流</th><th>月末累计余额</th></tr></thead><tbody>';
    reversed.forEach((m,idx)=>{
      const isFirst=idx===0;
      const rowStyle=isFirst?' style="background:rgba(0,229,255,0.10)"':'';
      h+='<tr'+rowStyle+'>';
      h+='<td>'+(isFirst?'<b>'+m.month+' 🔴当前</b>':m.month)+'</td>';
      h+='<td class="pay-green">¥'+Math.abs(m.pay_amount||0).toLocaleString()+'</td>';
      h+='<td class="recv-red">¥'+(m.recv_amount||0).toLocaleString()+'</td>';
      h+='<td class="cf-balance">¥'+(m.net||0).toLocaleString()+'</td>';
      h+='<td class="cf-balance">¥'+(m.balance||0).toLocaleString()+'</td>';
      h+='</tr>';
    });
    h+='</tbody></table></div></div>';
  }
  // 逐笔明细（倒序）
  if(cf.length){
    const reversedCf=[...cf].reverse();
    h+='<div class="panel"><h3>📄 逐笔现金流明细（'+cf.length+'笔，倒序）</h3><div class="twrap"><table class="ana-table"><thead><tr>';
    h+='<th>日期</th><th>类型</th><th>金额</th><th>累计余额</th></tr></thead><tbody>';
    reversedCf.forEach(e=>{
      const t=e.type==='PAY'?'💳 付款':'💰 回款';
      const amtCls=e.type==='PAY'?'pay-green':'recv-red';
      const amt=e.type==='PAY'?Math.abs(e.amount||0):(e.amount||0);
      h+='<tr><td>'+e.date+'</td><td>'+t+'</td><td class="'+amtCls+'">¥'+amt.toLocaleString()+'</td><td class="cf-balance">¥'+(e.balance||0).toLocaleString()+'</td></tr>';
    });
    h+='</tbody></table></div></div>';
  }
  document.getElementById('fundDetailContent').innerHTML=h;
  setTimeout(function(){drawCashflowChart(cm);},100);
}

function drawCashflowChart(cm){
  const el=document.getElementById('cashflowChart');
  if(!el || !window.echarts) return;
  const chart=echarts.init(el);
  const months=cm.map(m=>m.month);
  const balances=cm.map(m=>m.balance);
  chart.setOption({
    tooltip:{trigger:'axis',formatter:function(p){const v=p[0];return '<b>'+v.axisValue+'</b><br/>累计现金流：¥'+(v.value||0).toLocaleString();}},
    grid:{left:70,right:20,top:30,bottom:50},
    xAxis:{type:'category',data:months,axisLabel:{color:'#86909C',fontSize:10,rotate:35}},
    yAxis:{type:'value',axisLabel:{color:'#86909C',formatter:function(v){return (v/10000).toFixed(0)+'万';}}},
    series:[{
      name:'累计现金流',type:'line',data:balances,smooth:true,
      symbol:'circle',symbolSize:6,
      lineStyle:{width:2,color:'#165DFF'},
      itemStyle:{color:'#165DFF'},
      areaStyle:{color:'rgba(22,93,255,0.12)'},
    }]
  });
}

