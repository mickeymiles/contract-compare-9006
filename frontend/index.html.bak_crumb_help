  function monthCells(data,key){
    let h='';
    months.forEach(m=>{
      const grp=(data[key]||{})[m.key]||{};
      const cur=_val(grp.current,'-'), prev=_val(grp.previous,'-');
      h+='<td class="td-cur">'+_fmt(cur,'-')+'</td><td class="td-prev">'+_fmt(prev,'-')+'</td><td class="'+_clr(grp.diff)+'">'+_diff(cur,prev)+'</td>';
    });
    return h;
  }
  function monthCellsRaw(data,key){
    let h='';
    months.forEach(m=>{
      const grp=(data[key]||{})[m.key]||{};
      h+='<td>'+_val(grp.current,'-')+'</td><td>'+_val(grp.previous,'-')+'</td><td class="'+_clr(grp.diff)+'">'+_diff(grp.current,grp.previous)+'</td>';
    });
    return h;
  }

  const icid=d.icid||{}, dept=d.department||{}, zones=d.zones||[];

  let html='';

  // 区块1: ICID 整体汇总
  html+='<div class="ana-block"><div class="block-title">📊 ICID 整体汇总</div>';
  html+='<div class="twrap" style="max-height:none"><table class="ana-table">';
  html+='<thead><tr>'+monthSubHeaders('指标名称')+'</tr></thead><tbody>';
  html+='<tr><td class="metric-name">合同额（万元）</td>'+monthCells(icid,'contract_amount')+'</tr>';
  html+='<tr><td class="metric-name">项目个数</td>'+monthCells(icid,'project_count')+'</tr>';
  html+='<tr><td class="metric-name">当年累计回款周期（天）</td>'+monthCells(icid,'cumulative_days')+'</tr>';
  html+='<tr class="gray-row"><td class="metric-name">平均合同回款周期（天）</td>'+monthCells(icid,'avg_days')+'</tr>';
  html+='<tr class="gray-row"><td class="metric-name">平均合同回款周期（年）</td>'+monthCells(icid,'avg_years')+'</tr>';
  html+='</tbody></table></div></div>';

  // 区块2: 系统集成 部门汇总
  html+='<div class="ana-block"><div class="block-title">🏢 系统集成 部门汇总</div>';
  html+='<div class="twrap" style="max-height:none"><table class="ana-table">';
  html+='<thead><tr>'+monthSubHeaders('指标名称')+'</tr></thead><tbody>';
  html+='<tr><td class="metric-name">合同额（万元）</td>'+monthCells(dept,'contract_amount')+'</tr>';
  html+='<tr><td class="metric-name">项目个数</td>'+monthCells(dept,'project_count')+'</tr>';
  html+='<tr><td class="metric-name">当年累计回款周期（天）</td>'+monthCells(dept,'cumulative_days')+'</tr>';
  html+='<tr class="gray-row"><td class="metric-name">平均合同回款周期（天）</td>'+monthCells(dept,'avg_days')+'</tr>';
  html+='<tr class="gray-row"><td class="metric-name">平均合同回款周期（年）</td>'+monthCells(dept,'avg_years')+'</tr>';
  html+='</tbody></table></div></div>';

  // 区块3: 回款周期分区明细统计表
  html+='<div class="ana-block"><div class="block-title">📋 回款周期分区明细统计表</div>';
  html+='<div class="twrap" style="max-height:none"><table class="ana-table">';
  html+='<thead><tr class="zone-header"><th>回款周期分区</th>';
  months.forEach(m=>{html+='<th class="h-cur">'+m.current+'</th><th class="h-prev">'+m.last_year+'</th><th class="h-diff">差值</th>'});
  html+='</tr></thead><tbody>';
  const zoneLabels=['0.5以内','0.5-1年','1年以上','2年以上','3年以上','总计'];
  zones.forEach((z,i)=>{
    const cls=i===zones.length-1?'total-row':'';
    html+='<tr class="'+cls+'"><td class="metric-name">'+zoneLabels[i]+'</td>'+monthCellsRaw(z,'data')+'</tr>';
  });
  html+='</tbody></table></div></div>';

  // 底部注释
  html+='<div class="ana-footer"><div class="ana-foot-title">合同回款周期</div><div class="ana-foot-desc">Average（每笔合同最后一笔回款日期-合同生效日期）</div></div>';

  // ========== 可视化图表区（2列布局） ==========
  var lastKey=months[months.length-1].key;
  
  html+='<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">';
  
  // --- 左列: 项目个数同比 ---
  html+='<div class="ana-block" style="margin:0"><div class="block-title">📊 项目个数 同比对比</div>';
  html+='<div style="display:flex;gap:12px;flex-wrap:wrap">';
  for(var mi=0;mi<months.length;mi++){
    var mk=months[mi].key;
    var cv=icid.project_count[mk].current;
    var pv=icid.project_count[mk].previous;
    var maxV=Math.max(cv,pv,1);
    html+='<div style="text-align:center;min-width:100px">';
    html+='<div style="font-size:10px;color:var(--text2);margin-bottom:4px">'+months[mi].current+'</div>';
    html+='<div style="display:flex;align-items:flex-end;justify-content:center;gap:6px;height:100px">';
    html+='<div style="width:30px"><div style="height:'+Math.round(cv/maxV*100)+'px;background:var(--cyan);border-radius:4px 4px 0 0"></div><div style="font-size:10px;color:var(--cyan);margin-top:4px;font-weight:bold">'+cv+'</div></div>';
    html+='<div style="width:30px"><div style="height:'+Math.round(pv/maxV*100)+'px;background:var(--text2);border-radius:4px 4px 0 0"></div><div style="font-size:10px;color:var(--text2);margin-top:4px">'+pv+'</div></div>';
    html+='</div></div>';
  }
  html+='</div>';
  html+='<div style="font-size:10px;color:var(--text2);margin-top:4px"><span style="color:var(--cyan)">█ 2026</span> <span style="color:var(--text2);margin-left:8px">█ 2025</span></div></div>';
  
  // --- 右列: 平均回款周期同比 ---
  html+='<div class="ana-block" style="margin:0"><div class="block-title">📊 平均回款周期 同比（天）</div>';
  html+='<div style="display:flex;gap:12px;flex-wrap:wrap">';
  for(var mi2=0;mi2<months.length;mi2++){
    var mk2=months[mi2].key;
    var cv2=icid.avg_days[mk2].current;
    var pv2=icid.avg_days[mk2].previous;
    var maxV2=Math.max(cv2,pv2,1);
    html+='<div style="text-align:center;min-width:100px">';
    html+='<div style="font-size:10px;color:var(--text2);margin-bottom:4px">'+months[mi2].current+'</div>';
    html+='<div style="display:flex;align-items:flex-end;justify-content:center;gap:6px;height:100px">';
    html+='<div style="width:30px"><div style="height:'+Math.round(cv2/maxV2*100)+'px;background:var(--cyan);border-radius:4px 4px 0 0"></div><div style="font-size:10px;color:var(--cyan);margin-top:4px;font-weight:bold">'+cv2+'</div></div>';
    html+='<div style="width:30px"><div style="height:'+Math.round(pv2/maxV2*100)+'px;background:var(--text2);border-radius:4px 4px 0 0"></div><div style="font-size:10px;color:var(--text2);margin-top:4px">'+pv2+'</div></div>';
    html+='</div></div>';
  }
  html+='</div>';
  html+='<div style="font-size:10px;color:var(--text2);margin-top:4px"><span style="color:var(--cyan)">█ 2026</span> <span style="color:var(--text2);margin-left:8px">█ 2025</span></div></div>';
  
  // --- 左列: 回款周期分区分布 ---
  var zoneNames=['0.5以内','0.5-1年','1年以上','2年以上','3年以上'];
  var zoneCols=['#00B42A','#165DFF','#FF7D00','#F53F3F','#8B0000'];
  var zoneMax=0;
  for(var zi=0;zi<5;zi++){zoneMax=Math.max(zoneMax,zones[zi].data[lastKey].current);}
  html+='<div class="ana-block" style="margin:0"><div class="block-title">📊 回款周期分区分布（'+months[months.length-1].current+'）</div>';
  for(var zj=0;zj<5;zj++){
    var zv=zones[zj].data[lastKey].current;
    var zp=Math.round(zv/zoneMax*100);
    html+='<div style="display:flex;align-items:center;margin:5px 0;font-size:11px">';
    html+='<span style="width:65px;text-align:right;padding-right:8px;color:var(--text)">'+zoneNames[zj]+'</span>';
    html+='<div style="flex:1;background:#1a1a2e;border-radius:4px;overflow:hidden;height:20px">';
    html+='<div style="width:'+zp+'%;background:'+zoneCols[zj]+';height:100%;border-radius:4px;display:flex;align-items:center;justify-content:flex-end;padding-right:8px;font-size:10px;color:#fff;font-weight:bold">'+zv+'个</div>';
    html+='</div></div>';
  }
  html+='</div>';

  // --- 右列: 回款周期 × 合同金额 气泡图 ---
  var enriched=d.enriched_rows||[];
  if(enriched.length>0){
    var uid2='scatter_'+Date.now();
    html+='<div class="ana-block" style="margin:0"><div class="block-title">🔵 回款周期 × 合同金额（共'+enriched.length+'个合同）</div>';
    html+='<div id="'+uid2+'" style="width:100%;height:380px"></div>';
    html+='<div style="display:flex;gap:12px;margin-top:4px;font-size:10px;color:var(--text2)">';
    html+='<span style="color:#00B42A">● 0.5年内</span><span style="color:#165DFF">● 0.5-1年</span><span style="color:#FF7D00">● 1-2年</span><span style="color:#F53F3F">● 2-3年</span><span style="color:#8B0000">● 3年以上</span>';
    html+='</div></div>';
    setTimeout(function(){
      var el=document.getElementById(uid2);if(!el)return;
      var chart=echarts.init(el);
      var zoneColors={'0.5以内':'#00B42A','0.5-1年':'#165DFF','1年以上':'#FF7D00','2年以上':'#F53F3F','3年以上':'#8B0000'};
      var scatterData=enriched.map(function(r){
        var amt=(r.amount||0)/10000; // 元→万元
        var color=zoneColors[r.zone]||'#8893aa';
        return {value:[r.cycle_days||0, amt, amt], name:r.contract_no||'', signDate:r.sign_date||'', dept:r.dept||'', zone:r.zone||'', itemStyle:{color:color,opacity:0.7}};
      });
      var maxAmt=0; scatterData.forEach(function(d){maxAmt=Math.max(maxAmt,d.value[2]);});
      chart.setOption({
        tooltip:{trigger:'item',formatter:function(p){return '<b>'+p.data.name+'</b><br/>回款周期：'+p.data.value[0]+'天（'+p.data.zone+'）<br/>合同金额：'+(p.data.value[1]).toFixed(0)+'万元<br/>签约：'+p.data.signDate+'<br/>部门：'+p.data.dept;}},
        grid:{left:65,right:20,top:20,bottom:50},
        xAxis:{type:'value',name:'回款周期（天）',nameLocation:'center',nameGap:32,nameTextStyle:{color:'#8893aa',fontSize:10},axisLabel:{color:'#8893aa',fontSize:10},splitLine:{lineStyle:{color:'rgba(255,255,255,0.06)'}},min:0,max:function(v){return Math.ceil(v.max/300)*300;}},
        yAxis:{type:'value',name:'合同金额（万元）',nameTextStyle:{color:'#8893aa',fontSize:10},axisLabel:{color:'#8893aa',fontSize:10},splitLine:{lineStyle:{color:'rgba(255,255,255,0.06)'}}},
        series:[{type:'scatter',data:scatterData,
          symbolSize:function(val){var s=Math.max(8,Math.sqrt(val[2]/Math.max(maxAmt,1))*45);return s;},
          emphasis:{scale:1.5}
        }]
      });
    },250);
  }

  html+='</div>'; // close 2-col grid

  // --- 中国地图：独占一整行 ---
  var regions=d.regions||[];
  html+='<div class="ana-block" style="margin-top:20px"><div class="block-title">🗺️ 区域回款周期分布（'+months[months.length-1].current+'）</div>';
  html+=renderChinaMap(regions);
  html+='</div>';

  // 补充后的数据表（按回款周期从大到小排列）
  enriched=d.enriched_rows||[];
  const enrichedTotal=d.enriched_total||0;
  enriched.sort((a,b)=>(b.cycle_days||0)-(a.cycle_days||0));
  if(enriched.length>0){
    html+='<div class="ana-block" style="margin-top:24px"><div class="block-title" style="cursor:pointer" onclick="document.getElementById(\'enrichedTableWrap\').classList.toggle(\'open\');this.querySelector(\'.toggle-arrow\').textContent=document.getElementById(\'enrichedTableWrap\').classList.contains(\'open\')?\'▾\':\'▸\'">📋 补充后数据表 <span class="toggle-arrow" style="font-size:12px;color:var(--text2)">▸</span> <span style="font-size:11px;color:var(--text2);font-weight:normal">（共 '+enrichedTotal+' 条，显示前 '+enriched.length+' 条）</span></div>';
    html+='<div id="enrichedTableWrap" style="display:none;max-height:400px;overflow:auto"><table class="ana-table" style="font-size:10px"><thead><tr>';
    html+='<th>合同编号</th><th>签约日期</th><th>部门</th><th>最后一笔回款日期</th><th>回款周期(天)</th><th>年</th><th>分区</th>';
    html+='</tr></thead><tbody>';
    enriched.forEach(r=>{
      const daysStyle=r.cycle_days>500?' style="color:#F53F3F;font-weight:bold"':'';
      html+='<tr><td>'+r.contract_no+'</td><td>'+r.sign_date+'</td><td>'+r.dept+'</td><td>'+r.last_payback_date+'</td><td'+daysStyle+'>'+r.cycle_days+'</td><td>'+r.years+'</td><td>'+r.zone+'</td></tr>';
    });
    html+='</tbody></table></div></div>';
  }

  document.getElementById('anaContent').innerHTML=html;
}

goPortal();
</script>
</body>
</html>
