async function toggleTableHistory(tableName){
  const elId='verlist-'+tableName.replace(/\s+/g,'_');
  const el=document.getElementById(elId);
  if(!el)return;
  const isOpen=!el.classList.contains('open');
  if(isOpen){
    const r=await fetch(API+'/api/datasource/versions?table_name='+encodeURIComponent(tableName)).then(r=>r.json());
    const vers=r.versions||[];
    const latestId=r.latest_id;
    el.innerHTML=vers.map(v=>{
      const isLatest=v.id===latestId;
      const delBtn=!isLatest?`<span class=\"vdel\" onclick=\"deleteTableVersion('${tableName}',${v.id})\">删除</span>`:'';
      return `<div class=\"dtc-ver-row\">\n        <span class=\"vmini${isLatest?' latest':''}\">v${v.id}${isLatest?'·当前':''}</span>\n        <span>${v.upload_time}</span>\n        <span style=\"color:var(--text2)\">${v.filename} · ${v.row_count}行</span>\n        ${delBtn}\n      </div>`;
    }).join('');
    el.classList.add('open');
  }else{
    el.classList.remove('open');
  }
}
async function deleteTableVersion(tableName,vid){
  if(!confirm(`确定删除 ${tableName} 版本 v${vid}？`))return;
  const r=await fetch(API+'/api/datasource/version/'+encodeURIComponent(tableName)+'/'+vid,{method:'DELETE'}).then(r=>r.json());
  if(r.success){toast(`v${vid} 已删除`);loadDsTables();loadDsStatus()}
  else toast(r.error||'删除失败',false);
}

