async function loadDsStatus(){
  try{
    const r=await fetch(API+'/api/datasource/tables').then(r=>r.json());
    const tables=r.tables||[];
    const tableNames=['总合同表','项目里程碑表','付款明细表','收款明细表'];
    const tableMap={};
    tables.forEach(t=>{tableMap[t.name]=t});
    const uploaded=tableNames.filter(n=>tableMap[n]&&tableMap[n].version_count>0).length;
    const total=tableNames.length;
    if(uploaded===0){
      document.getElementById('dsStatus').innerHTML='<span style=\"color:var(--text2)\">暂无数据，点击进入上传</span>';
    }else{
      // 找到最大的最新版本号
      const maxVer=Math.max(...tables.filter(t=>t.latest_id).map(t=>t.latest_id),0);
      document.getElementById('dsStatus').innerHTML=`<span class=\"ver\">${uploaded}/${total} 张表已就绪</span> · 最新 v${maxVer}`;
    }
    // 同时缓存给数据源管理页用
    window._dsTables=tables;
  }catch(e){}
}
async function loadDsTables(){
  try{
    const r=await fetch(API+'/api/datasource/tables').then(r=>r.json());
    window._dsTables=r.tables||[];
  }catch(e){window._dsTables=[]}
  const tables=window._dsTables;
  const tableNames=['总合同表','项目里程碑表','付款明细表','收款明细表'];
  // 确保两张基础表始终显示
  const tableMap={};
  tables.forEach(t=>{tableMap[t.name]=t});
  const cards=tableNames.map(name=>{
    const t=tableMap[name]||{name,version_count:0,latest_id:null,latest_time:null,latest_rows:0,latest_columns:[]};
    const hasData=t.version_count>0;
    return `<div class=\"ds-table-card\">\n      <div class=\"dtc-header\">\n        <div class=\"dtc-icon\">📄</div>\n        <div class=\"dtc-title\">${name}</div>\n        <span class=\"vtag${hasData?'':' none'}\" style=\"margin-left:auto\">${hasData?`v${t.latest_id}`:'未上传'}</span>\n      </div>\n      <div class=\"dtc-meta\">\n        ${hasData?`<div>${t.latest_time} · ${t.latest_rows} 条记录 · ${t.latest_columns.length} 列</div><div style=\"color:var(--text2);margin-top:3px\">列: ${t.latest_columns.slice(0,6).join(' / ')}${t.latest_columns.length>6?' ...':''}</div>`:'<div style=\"color:var(--orange)\">尚未上传数据</div>'}\n      </div>\n      <div class=\"dtc-actions\">\n        <label class=\"upzone\" style=\"cursor:pointer\">\n          📤 上传 ${name}\n          <input type=\"file\" accept=\".xlsx,.xls\" onchange=\"uploadTableFile('${name}',this)\">\n        </label>\n        ${hasData?`<button class=\"btn btn-o btn-s\" onclick=\"toggleTableHistory('${name}')\">📋 版本 (${t.version_count})</button>`:''}\n      </div>\n      <div class=\"dtc-verlist\" id=\"verlist-${name.replace(/\s+/g,'_')}\"></div>\n    </div>`;
  });
  // 加号卡片
  cards.push(`<div class=\"ds-table-card add-table\"><div style=\"text-align:center\"><div style=\"font-size:28px;color:var(--text2);margin-bottom:4px\">＋</div><div style=\"font-size:11px;color:var(--text2)\">后续扩展</div></div></div>`);
  document.getElementById('dsTableCards').innerHTML=cards.join('');
}
