function renderFundResult(data){
  let html='';
  // Summary cards（按维度分行：累计类 / 占用类 / 元数据类）
  if(data.summary){
    const s=data.summary;
    const getVal=k=>{const v=s[k];return (v&&v.value!=null)?v.value:v;};
    const sizeFor=v=>{const l=String(v).length;return l<=5?'24px':l<=10?'22px':l<=15?'19px':'16px';};
    const rows=[
      ['累计付款总额','累计收款总额'],
      ['当前资金占用总额','总加权资金占用','预估资金成本'],
      ['合同总数','年化成本率','报表截止日'],
    ];
    rows.forEach(row=>{
      html+=`<div class="cards" style="margin-bottom:12px;grid-template-columns:repeat(${row.length},1fr);gap:16px">`;
      row.forEach(k=>{
        const val=getVal(k);
        if(val===undefined||val===null)return;
        html+=`<div class="card"><div class="lbl">${k}</div><div class="val c" style="font-size:${sizeFor(val)}">${val}</div></div>`;
      });
      html+='</div>';
    });
  }
  // Detail table
  if(data.rows&&data.rows.length){
    html+='<div class="panel"><h3>📋 资金占用明细</h3>';
    html+='<div style="margin-bottom:12px;display:flex;align-items:center;gap:8px">';
    html+='<span style="font-size:12px;color:var(--text2)">🔍</span>';
    html+='<input id="fundFilter" placeholder="输入合同编号模糊筛选..." style="flex:1;max-width:320px;padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:var(--bg2);color:var(--text);font-size:12px" oninput="filterFundTable()">';
    html+='<span id="fundFilterCount" style="font-size:11px;color:var(--text2)"></span>';
    html+='</div>';
    html+='<div class="twrap" id="fundTableWrap"><table class="ana-table" id="fundTable"><thead><tr>';
    const cols=data.columns||Object.keys(data.rows[0]);
    cols.forEach(c=>{html+=`<th>${c}</th>`;});
    html+='<th>操作</th></tr></thead><tbody>';
    const textCols=new Set(['合同编号','客户名称','项目名称','周期起始日','年化成本率']);
    const numCols=new Set(['合同额','累计付款','累计收款','净现金流','当前资金占用','元天合计','周期总天数','平均资金占用','预估资金成本','片段数','已结清片段','占用中片段']);
    const payCols=new Set(['累计付款','当前资金占用','平均资金占用','预估资金成本','周期总天数']);
    const recvCols=new Set(['累计收款']);
    const cfCols=new Set(['净现金流']);
    data.rows.forEach(row=>{
      html+='<tr>';
      cols.forEach(c=>{
        const v=row[c];
        let cls='';
        if(textCols.has(c))cls='wrap';
        else if(numCols.has(c))cls='num';
        if(payCols.has(c))cls+=' pay-green';
        else if(recvCols.has(c))cls+=' recv-red';
        else if(cfCols.has(c))cls+=' cf-balance';
        if(typeof v==='number'&&v>0&&numCols.has(c)&&!payCols.has(c)&&!recvCols.has(c)&&!cfCols.has(c))cls+=' pos';
        html+=`<td class="${cls.trim()}">${v!=null?v:'-'}</td>`;
      });
      const cno=row['合同编号']||row['contract_id']||'';
      html+=`<td><button class="btn btn-o btn-sm" onclick="showFundDetail('${cno}')">查看详情</button></td>`;
      html+='</tr>';
    });
    html+='</tbody></table></div></div>';
  }
  if(!html)html='<div class="ana-empty"><div>暂无分析结果</div></div>';
  document.getElementById('fundContent').innerHTML=html;
  if(data&&data.rows) document.getElementById('fundFilterCount').textContent='共 '+data.rows.length+' 条';
}

function filterFundTable(){
  const kw=document.getElementById('fundFilter').value.toUpperCase();
  const rows=document.querySelectorAll('#fundTable tbody tr');
  let cnt=0;
  rows.forEach(tr=>{
    const cno=tr.cells[0]?.textContent?.toUpperCase()||'';
    const match=!kw||cno.includes(kw);
    tr.style.display=match?'':'none';
    if(match)cnt++;
  });
  document.getElementById('fundFilterCount').textContent=cnt+' / '+rows.length+' 条';
}

