// ===== 聊天功能 =====
let chatOpen=false,chatLoading=false,lastMsgId=0,chatEventSource=null;

function toggleChat(){
  chatOpen=!chatOpen;
  document.getElementById('chatPanel').classList.toggle('open',chatOpen);
  if(chatOpen){document.getElementById('chatInput').focus();loadChatHistory();connectSSE()}
  else{if(chatEventSource)chatEventSource.close()}
}

async function loadChatHistory(){
  try{
    const r=await fetch(API+'/api/chat/messages?since_id='+lastMsgId).then(r=>r.json());
    r.messages.forEach(addChatMsg);
    if(r.messages.length)lastMsgId=r.messages[r.messages.length-1].id;
  }catch(e){}
}

function addChatMsg(m){
  const container=document.getElementById('chatMsgs');
  const cls=m.role==='user'?'user':'assistant';
  const time=m.created_at?m.created_at.substring(11,16):'';
  const div=document.createElement('div');
  div.className='msg '+cls;
  div.innerHTML='<div>'+m.content.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>')+'</div><div class="time">'+time+'</div>';
  container.appendChild(div);
  container.scrollTop=container.scrollHeight;
  if(m.id>lastMsgId)lastMsgId=m.id;
}

function connectSSE(){
  if(chatEventSource)chatEventSource.close();
  chatEventSource=new EventSource(API+'/api/chat/stream');
  chatEventSource.onmessage=function(e){
    try{const m=JSON.parse(e.data);addChatMsg(m);document.getElementById('chatTyping').classList.remove('show')}
    catch(err){}
  };
  chatEventSource.onerror=function(){setTimeout(connectSSE,5000)};
}

async function sendChat(){
  const inp=document.getElementById('chatInput'),text=inp.value.trim();
  if(!text||chatLoading)return;
  chatLoading=true;inp.value='';inp.disabled=true;
  document.getElementById('chatTyping').classList.add('show');
  const fd=new FormData();fd.append('message',text);
  try{
    await fetch(API+'/api/chat/send',{method:'POST',body:fd});
  }catch(e){}
  chatLoading=false;inp.disabled=false;inp.focus();
}

