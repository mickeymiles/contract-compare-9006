async function uploadTableFile(tableName,inp){
  const f=inp.files[0];if(!f)return;
  const fd=new FormData();fd.append('file',f);
  try{
    const r=await fetch(API+'/api/datasource/upload?table_name='+encodeURIComponent(tableName),{method:'POST',body:fd}).then(r=>r.json());
    if(r.success){toast(`${tableName} v${r.version.id} 上传成功！${r.version.row_count} 条`);loadDsTables();loadDsStatus()}
    else toast(r.error,false);
  }catch(e){toast('上传失败',false)}
